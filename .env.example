# MalScanWorker Environment Variables
# Copy this file to .env and fill in the values for your environment

# =============================================================================
# REQUIRED - No defaults (must be provided for security)
# =============================================================================

# PostgreSQL database connection string
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/malscan

# MinIO configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key

# RabbitMQ connection URL
RABBITMQ_URL=amqp://guest:your_password@localhost:5672/

# =============================================================================
# OPTIONAL - Defaults provided
# =============================================================================

# MinIO buckets (optional, defaults shown)
# MINIO_BUCKET_UPLOADS=uploads
# MINIO_BUCKET_ARTIFACTS=artifacts
# MINIO_SECURE=false

# RabbitMQ queue name (optional, default: malscan.jobs)
# RABBITMQ_QUEUE=malscan.jobs

# CORS origins (optional, default: *)
# CORS_ORIGINS=*

# Logging (optional)
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# File upload (optional)
# MAX_FILE_SIZE=104857600  # 100MB in bytes

# Go Ingest upload rate limit (defaults shown)
# UPLOAD_RATE_LIMIT_ENABLED=true
# UPLOAD_RATE_LIMIT_RPM=6
# UPLOAD_RATE_LIMIT_BURST=2

# Optional server-side Bearer auth for Go Ingest uploads (disabled by default).
# Keep empty while disabled; never commit a real key here.
UPLOAD_AUTH_ENABLED=false
UPLOAD_API_KEY=

# Worker stage configuration (optional)
# STAGE_TIMEOUT_SECONDS=300
# STAGES_TOTAL=9

# YARA rules path (optional)
# YARA_RULES_PATH=/etc/yara/rules

# ClamAV configuration (optional)
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# Sandbox configuration (optional; dynamic detonation is disabled by default)
SANDBOX_ENABLED=false
# The mock provider emits synthetic behavior and is for development/testing only.
SANDBOX_PROVIDER=capev2
# CAPEv2 requires an existing host and analysis guests, reachable from containers.
# Configure these, then run scripts/enable-sandbox.sh (read-only preflight first).
# The script does not install CAPE or create VMs. Never commit a real token.
SANDBOX_BASE_URL=
SANDBOX_API_TOKEN=
# SANDBOX_TIMEOUT_SECONDS=900
# SANDBOX_POLL_INTERVAL_SECONDS=10
# SANDBOX_PREFLIGHT_TIMEOUT_SECONDS=10
# SANDBOX_ENABLE_URL_SUBMISSION=false
# Mock is explicit development data only, never a provider failure fallback:
# SANDBOX_PROVIDER=mock scripts/enable-sandbox.sh --allow-mock
# SANDBOX_MOCK is ignored by provider selection.

# Root-tree cumulative extracted files/bytes; each execution attempt has its own
# deadline window. Resume retains cumulative reservations and completed stages.
# ROOT_BUDGET_MAX_FILES=100
# ROOT_BUDGET_MAX_BYTES=500000000
# ROOT_BUDGET_TIMEOUT_SECONDS=3600
# MAX_JOB_DEPTH=3
# See docs/analysis-support.md for supported formats and extraction boundaries.

# Portable CLI may use the local clamscan binary instead of a daemon.
# CLAMAV_MODE=daemon
# CLAMAV_CLI_PATH=clamscan
# CLAMAV_DATABASE_PATH=/var/lib/clamav
# Self-hosted Compose keeps signed databases updated by default. Offline setups
# may disable the updater, but must refresh/verify databases separately.
# CLAMAV_NO_FRESHCLAMD=false
# CLAMAV_MAX_DATABASE_AGE_SECONDS=604800  # portable cli daily.cvd freshness guard

# Metrics port (optional)
# METRICS_PORT=9090
