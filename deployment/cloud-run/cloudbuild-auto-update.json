{
  "steps": [
    {
      "id": "database-update-controller",
      "name": "gcr.io/google.com/cloudsdktool/google-cloud-cli:stable",
      "entrypoint": "python3",
      "args": [
        "deployment/cloud-run/auto_update.py",
        "run",
        "--bucket",
        "$_OPS_BUCKET",
        "--owner-build-id",
        "$BUILD_ID"
      ]
    }
  ],
  "substitutions": {
    "_OPS_BUCKET": "REPLACE_OPS_BUCKET"
  },
  "tags": [
    "malscan-db-controller"
  ],
  "timeout": "1800s",
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
