{
  "steps": [
    {
      "id": "database-update-controller",
      "name": "gcr.io/google.com/cloudsdktool/google-cloud-cli@sha256:18d8c484aaef27d7ef7b54dfb018f73712503d254a16f0a76b2626b4f6003af2",
      "entrypoint": "/usr/lib/google-cloud-sdk/platform/bundledpythonunix/bin/python3",
      "env": [
        "SSL_CERT_FILE=/usr/lib/google-cloud-sdk/lib/third_party/certifi/cacert.pem"
      ],
      "args": [
        "deployment/cloud-run/auto_update.py",
        "run",
        "--bucket",
        "$_OPS_BUCKET",
        "--owner-build-id",
        "$BUILD_ID"
      ]
    }
  ],
  "substitutions": {
    "_OPS_BUCKET": "REPLACE_OPS_BUCKET"
  },
  "tags": [
    "malscan-db-controller"
  ],
  "timeout": "1800s",
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
